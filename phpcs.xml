<?xml version="1.0"?>
<ruleset name="new-DH-user-site">
    <description>
        Template style gate: PSR-12 over classes/, wwwroot/, prepend.php and
        Tests/, enforced on every commit by .githooks/pre-commit. Fix with
        phpcbf where it can. (templates/*.tpl.php are mixed HTML/PHP and out
        of scope.) Clones inherit this file, so keeping it strict keeps every
        future site strict. The two narrow exclusions below are deliberate,
        not a backlog.
    </description>

    <file>classes</file>
    <file>wwwroot</file>
    <file>prepend.php</file>
    <file>Tests</file>
    <file>bin</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/Tests/_output/*</exclude-pattern>
    <exclude-pattern>*/Tests/Support/_generated/*</exclude-pattern>

    <rule ref="PSR12"/>

    <!-- prepend.php is the bootstrap every page includes: it runs the request
         setup and also declares the few global helpers templates call
         (csrf_field(), csrf_token(), print_rob()). Every other file stays
         either declarations or logic. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>*/prepend.php</exclude-pattern>
    </rule>

    <!-- Codeception calls _before() and _after() by those exact names. -->
    <rule ref="PSR2.Methods.MethodDeclaration.Underscore">
        <exclude-pattern>*/Tests/*</exclude-pattern>
    </rule>
</ruleset>
